98/Math/MathML\"><semantics><mrow><msub><mi>m</mi><mi>l</mi></msub></mrow><annotation encoding=\"application/x-tex\">m_l</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.5806em;vertical-align:-0.15em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\">m</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:0em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\" style=\"margin-right:0.01968em;\">l</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span>","key":"s8OOqr3qCW"},{"type":"text","value":" 取值从 ","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"hu1jq0Vz8z"},{"type":"inlineMath","value":"-l","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo>−</mo><mi>l</mi></mrow><annotation encoding=\"application/x-tex\">-l</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7778em;vertical-align:-0.0833em;\"></span><span class=\"mord\">−</span><span class=\"mord mathnormal\" style=\"margin-right:0.01968em;\">l</span></span></span></span>","key":"jJ6A4APPuV"},{"type":"text","value":" 到 ","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"Z1IZ1EpZjx"},{"type":"inlineMath","value":"+l","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo>+</mo><mi>l</mi></mrow><annotation encoding=\"application/x-tex\">+l</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.7778em;vertical-align:-0.0833em;\"></span><span class=\"mord\">+</span><span class=\"mord mathnormal\" style=\"margin-right:0.01968em;\">l</span></span></span></span>","key":"skr62OeA7W"},{"type":"text","value":"，决定角动量在空间中的取向。自旋量子数 ","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"GEzT6FNmgg"},{"type":"inlineMath","value":"s","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>s</mi></mrow><annotation encoding=\"application/x-tex\">s</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">s</span></span></span></span>","key":"Mre1oyp9vV"},{"type":"text","value":" 描述电子的内禀角动量，只能取 ","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"j3OgFsoA1f"},{"type":"inlineMath","value":"\\pm 1/2","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mo>±</mo><mn>1</mn><mi mathvariant=\"normal\">/</mi><mn>2</mn></mrow><annotation encoding=\"application/x-tex\">\\pm 1/2</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord\">±</span><span class=\"mord\">1/2</span></span></span></span>","key":"HKCZ2ZGg10"},{"type":"text","value":"。","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"iz5byhfz8S"}],"key":"mlscBKTFje"},{"type":"paragraph","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"children":[{"type":"text","value":"这四个量子数完全确定了电子的量子态。泡利不相容原理指出，两个电子不能占据完全相同的量子态。这个简单的原理解释了元素周期表的结构：电子按照能级顺序填充，每个轨道最多容纳两个自旋相反的电子，当一层填满后开始填下一层。化学性质的周期性，源于电子配置的周期性。门捷列夫凭直觉排出的周期表，在量子力学中获得了第一性原理的解释。","position":{"start":{"line":65,"column":1},"end":{"line":65,"column":1}},"key":"NvsOOvOi6J"}],"key":"u3q6hRCIKQ"},{"type":"paragraph","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"children":[{"type":"text","value":"精细结构进一步揭示了细节。自旋-轨道耦合使能级发生分裂，相对论修正带来额外的位移。这些\"微小\"的效应，在高精度光谱实验中清晰可见，成为检验量子电动力学的试金石。兰姆位移的测量精度达到十几位有效数字，与理论计算的吻合是人类科学史上最精确的验证之一。","position":{"start":{"line":67,"column":1},"end":{"line":67,"column":1}},"key":"ENSEGn9PGO"}],"key":"sV90GbJHUA"},{"type":"heading","depth":2,"position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"本书的结构与阅读建议","position":{"start":{"line":69,"column":1},"end":{"line":69,"column":1}},"key":"IzSfFWYEWJ"}],"identifier":"id","label":"本书的结构与阅读建议","html_id":"id-6","implicit":true,"key":"JVsLwxVf31"},{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"children":[{"type":"text","value":"本书沿着物理学自身的历史逻辑展开，同时在每个节点引入计算视角。","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"ibE9rir9eI"}],"key":"RiDce3ckPN"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"children":[{"type":"text","value":"第一章从卢瑟福散射开始，讲述如何通过\"轰击\"来探测原子的内部结构。你将看到散射实验的数据如何排除了汤姆孙模型，如何指向一个集中的原子核，以及为什么这个发现在经典物理的框架下立刻导致危机。在这一章的硅基视角部分，我们将用蒙特卡洛方法模拟粒子束轰击原子核的过程，重现卢瑟福的发现。","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"vhas5Wg2Xq"}],"key":"nHOlGJLGS9"},{"type":"paragraph","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"第二章转向光谱，追溯从巴尔末公式到玻尔模型的路径。你将看到离散的谱线如何暗示离散的能级，玻尔如何用量子化假设解释氢原子光谱，弗兰克-赫兹实验如何提供独立的验证。硅基视角将帮助你理解能量态如同数字信号的电平，跃迁如同状态机的切换。","position":{"start":{"line":75,"column":1},"end":{"line":75,"column":1}},"key":"pSb4K2Qox9"}],"key":"U8PvZo5KhL"},{"type":"paragraph","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"children":[{"type":"text","value":"第三章进入波粒二象性和不确定性原理。你将看到德布罗意如何把波的概念推广到物质，电子衍射实验如何证实这一点，以及海森堡如何从这些事实中提炼出测量的根本限制。傅里叶变换将成为理解不确定性原理的关键工具，从数据处理的角度展示为什么位置和动量不能同时精确确定。","position":{"start":{"line":77,"column":1},"end":{"line":77,"column":1}},"key":"fA0VuvTlKP"}],"key":"kceIjkHFN8"},{"type":"paragraph","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"children":[{"type":"text","value":"第四章是量子力学的核心：薛定谔方程。你将学习如何写下方程，如何求解氢原子，如何理解量子数和电子云的形状。这一章的数学要求最高，但也是最有回报的。硅基视角将把微分方程转化为本征值问题，用数值方法求解电子的概率分布。","position":{"start":{"line":79,"column":1},"end":{"line":79,"column":1}},"key":"n7dcekYtZZ"}],"key":"YzurR6v0WK"},{"type":"paragraph","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"children":[{"type":"text","value":"第五章探讨精细结构和自旋。你将看到简单的能级图如何在高分辨率下展现出复杂的分裂，自旋如何作为一个全新的自由度进入物理学，以及如何用微扰论处理这些\"小修正\"。微扰论类似于软件开发中的\"补丁\"或迭代优化算法，在主程序基础上添加修正项。","position":{"start":{"line":81,"column":1},"end":{"line":81,"column":1}},"key":"bGtGnRiLm1"}],"key":"DLwMnF35cO"},{"type":"paragraph","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"children":[{"type":"text","value":"每一章都包含三条线索：物理叙事追溯概念如何演化、图景如何更替，这是理解物理思想的核心脉络；硅基视角用计算机科学的类比和数值方法重新诠释物理概念；AI Workshop 提供可运行的代码，让你亲身体验反编译的过程。你可以根据自己的背景选择侧重，但建议至少完整阅读物理叙事部分。","position":{"start":{"line":83,"column":1},"end":{"line":83,"column":1}},"key":"QWeVa7wD26"}],"key":"P8TllCjngH"},{"type":"heading","depth":2,"position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"children":[{"type":"text","value":"写给不同背景的读者","position":{"start":{"line":85,"column":1},"end":{"line":85,"column":1}},"key":"WV2Wv5LMcI"}],"identifier":"id","label":"写给不同背景的读者","html_id":"id-7","implicit":true,"key":"UUCnHpJSnB"},{"type":"paragraph","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"children":[{"type":"text","value":"如果你是物理专业学生，这本书会帮助你把原子物理课程中的知识点串联成一条逻辑链。你可能已经学过薛定谔方程和氢原子的解，但你可能不清楚这些结果是如何从历史困境中被逼出来的。本书的历史视角会加深你对\"为什么是这样\"的理解，计算视角会让你的掌握更加扎实。","position":{"start":{"line":87,"column":1},"end":{"line":87,"column":1}},"key":"Q4Tj0Gmz9k"}],"key":"CvXv1nzOC4"},{"type":"paragraph","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"children":[{"type":"text","value":"如果你来自计算机或工程背景，这本书用你熟悉的语言重新讲述原子物理。你会发现量子力学并不神秘，它只是用不同的数据结构和算法来描述世界。波函数是一种数据结构，算符是一种操作，测量是一种查询。傅里叶变换、本征值问题、蒙特卡洛方法，这些你熟悉的工具在这里都有用武之地。","position":{"start":{"line":89,"column":1},"end":{"line":89,"column":1}},"key":"lrbLESfhEd"}],"key":"oh2MMY2R0f"},{"type":"paragraph","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"children":[{"type":"text","value":"如果你是好奇的普通读者，你可以跳过数学推导，沿着物理叙事阅读。你会读到一个关于人类如何认识微观世界的精彩故事。那些物理学家不是神，他们会困惑，会犯错，会争论，会在证据面前放弃自己心爱的理论。但他们最终找到了一种描述世界的新语言，这种语言比我们的直觉更接近真相。","position":{"start":{"line":91,"column":1},"end":{"line":91,"column":1}},"key":"xYOvEFPmNe"}],"key":"en5k8OSqgE"},{"type":"heading","depth":2,"position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"children":[{"type":"text","value":"最后的邀请","position":{"start":{"line":93,"column":1},"end":{"line":93,"column":1}},"key":"IWURpY8xjF"}],"identifier":"id","label":"最后的邀请","html_id":"id-8","implicit":true,"key":"NZibcJLF3C"},{"type":"paragraph","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"children":[{"type":"text","value":"原子物理是一扇门。门的这边是我们熟悉的宏观世界，连续的、确定的、可以用日常语言描述的。门的那边是微观世界，离散的、概率性的、需要新语言才能表达的。跨过这扇门，你不会失去什么，你只会获得：一种更深刻的理解，一套更强大的工具，一种更谦逊也更自信的认知姿态。","position":{"start":{"line":95,"column":1},"end":{"line":95,"column":1}},"key":"udtL1t4hV0"}],"key":"t5dcXoXIGy"},{"type":"paragraph","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"children":[{"type":"text","value":"两百年前，没有人知道原子是什么。一百年前，没有人知道如何描述原子。今天，我们可以计算氢原子的能级精确到小数点后十几位，可以操控单个原子的量子态，可以利用量子效应制造改变世界的技术。这是人类认知史上最惊人的进步之一，而你即将成为这个故事的参与者。","position":{"start":{"line":97,"column":1},"end":{"line":97,"column":1}},"key":"nGij2Fajod"}],"key":"NAuwbECA0w"},{"type":"paragraph","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"children":[{"type":"text","value":"翻过这一页，我们开始解码。","position":{"start":{"line":99,"column":1},"end":{"line":99,"column":1}},"key":"jij832brld"}],"key":"rzD6iRBEWB"}],"key":"XGJSfC32T0"}],"key":"r9wMDXNAzE"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"源代码：原子物理的逆向工程","url":"/","group":"源代码：原子物理的逆向工程"},"next":{"title":"第一章 原子的核式结构","url":"/ch01/intro","group":"第一章 原子的核式结构"}}},"domain":"http://localhost:3000"}